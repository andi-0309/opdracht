APP_NAME=Opdracht
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

# Nur für compose.https.yaml: öffentlich erreichbare Domain ohne https://
# APP_DOMAIN=opdracht.example.com
TRUSTED_PROXIES=

DB_CONNECTION=sqlite
# Lokal ohne Docker: absoluter Pfad, oder auskommentiert lassen.
# DB_DATABASE=/absolute/path/database/database.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
